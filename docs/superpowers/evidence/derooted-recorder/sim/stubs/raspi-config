#!/bin/sh
# Keeps I2C state in a file, the way raspi-config keeps it in config.txt, so a
# re-run sees what the first run enabled. No camera toggle, as on trixie.
echo "STUB raspi-config $*" >> /var/log/visio-sim-stubs.log
state=/var/lib/visio-sim-i2c
case "$2" in
  get_i2c) [ -f "$state" ] && echo 0 || echo 1 ;;
  do_i2c) touch "$state" ;;
  get_camera) exit 1 ;;
esac
